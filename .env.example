# ==============================================================================
# BloodLink AI - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Core Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development                    # 'development' or 'production'
SECRET_KEY=generate-a-strong-random-key-for-production-min-32-chars

# Database Configuration (PostgreSQL / Supabase recommended for production; SQLite for dev)
# For Supabase PostgreSQL, ensure sslmode=require is specified.
DATABASE_URL=sqlite:///instance/bloodlink.db
# Example Supabase: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Rate Limiting & Brute-Force Defenses (Flask-Limiter)
# In production with multiple workers/nodes, set RATELIMIT_STORAGE_URI to Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per minute
LOGIN_RATE_LIMIT=10 per minute; 50 per hour
REGISTER_RATE_LIMIT=5 per minute; 20 per hour
PASSWORD_RESET_RATE_LIMIT=3 per minute; 10 per hour

# Account Lockout & Throttling Policies
MAX_FAILED_LOGIN_ATTEMPTS=5              # Failed logins before 15-minute temporary lockout
LOGIN_LOCKOUT_MINUTES=15                 # Lockout window in minutes
PASSWORD_RESET_TOKEN_MINUTES=15          # Cryptographic reset token lifetime

# Reverse Proxy Security
# Set to 'true' ONLY when running behind a trusted reverse proxy (e.g., Nginx, Cloudflare, AWS ALB)
BEHIND_TRUSTED_PROXY=false

# Administrative Multi-Factor Authentication
# When true, administrators must verify a TOTP code (Google Authenticator / Authy)
REQUIRE_ADMIN_MFA=false                  # Defaults to true automatically in ProductionConfig
